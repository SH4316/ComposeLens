# Local HTTP port.
PORT=8080

# Cloudflare Tunnel token. Leave empty to disable the connector.
# Copy only the long eyJ... value after --token in the connector install command.
# A tunnel UUID or Cloudflare API token cannot be used here.
# Set the tunnel's published application service to http://web:8080.
CLOUDFLARE_TUNNEL_TOKEN=

# Derived automatically from the token; keep this expression unchanged.
CLOUDFLARE_TUNNEL_REPLICAS=${CLOUDFLARE_TUNNEL_TOKEN:+1}
