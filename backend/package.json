{
  "name": "@composelens/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev ../frontend/dist --port 8788",
    "build": "tsc --noEmit && wrangler pages functions build functions --outdir dist",
    "build:pages": "npm --prefix ../frontend ci && npm --prefix ../frontend run build -- --outDir ../backend/dist/pages",
    "build:node": "tsc --noEmit && esbuild server/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@composelens/shared": "file:../shared"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
